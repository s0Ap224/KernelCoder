# Copy to .env and fill in your provider settings. Never commit real keys.
KERNELCODER_API_KEY=
KERNELCODER_BASE_URL=
# Use a model identifier available from your provider.
KERNELCODER_MODEL=
KERNELCODER_PROVIDER=openai
KERNELCODER_MAX_TOKENS=4096
KERNELCODER_MAX_CONTEXT=128000
KERNELCODER_TEMPERATURE=0
# Required only for E2B execution.
E2B_API_KEY=
